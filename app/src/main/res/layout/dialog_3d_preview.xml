<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/ic_check"
    android:backgroundTint="@color/card_dark_slate"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPreviewSet"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SET 1: LOWER BODY"
                android:textColor="@color/neon_mint"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPreviewTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Exercise Name"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClosePreview"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_check"
            app:tint="@color/text_secondary" />
    </RelativeLayout>

    <!-- 3D Video / Animation View -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="@color/bg_obsidian"
        app:cardCornerRadius="20dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/card_border"
        app:strokeWidth="1dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <VideoView
                android:id="@+id/videoPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_centerInParent="true" />

            <ImageView
                android:id="@+id/ivPreviewPlaceholder"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="50dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_exercise"
                app:tint="@color/neon_mint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="12dp"
                android:background="@drawable/ic_check"
                android:backgroundTint="#DD0B0F19"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🎬 EXERCISE FORM DEMO"
                android:textColor="@color/neon_mint"
                android:textSize="10sp"
                android:textStyle="bold" />
        </RelativeLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Coaching Cue -->
    <TextView
        android:id="@+id/tvPreviewCue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:lineSpacingExtra="3dp"
        android:text="Detailed biomechanical coaching cue."
        android:textColor="@color/text_primary"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/tvPreviewWarning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/ic_check"
        android:backgroundTint="@color/amber_light"
        android:padding="8dp"
        android:text="⚠️ Precaution"
        android:textColor="@color/amber_accent"
        android:textSize="12sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGotIt"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="16dp"
        android:text="Got It"
        android:textAllCaps="false"
        android:textColor="@color/bg_obsidian"
        android:textStyle="bold"
        app:backgroundTint="@color/neon_mint"
        app:cornerRadius="14dp" />

</LinearLayout>
