<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_accent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Walk Icon / Illustration placeholder -->
    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/ic_check"
        android:backgroundTint="#33FFFFFF"
        android:contentDescription="Walk icon"
        android:padding="20dp"
        android:src="@drawable/ic_walk"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvWalkTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚶 Time to Walk!"
        android:textColor="@color/white"
        android:textSize="28sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvWalkSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="Get up from your chair, stretch your legs, and walk for 3–5 minutes. Decompress your lumbar spine."
        android:textColor="@color/blue_light"
        android:textSize="15sp" />

    <!-- Walk Countdown (Shown when walking starts) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardWalkTimer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/surface_card"
        app:cardCornerRadius="20dp"
        app:cardElevation="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WALKING TIME REMAINING"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvWalkTimerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="05:00"
                android:textColor="@color/blue_accent"
                android:textSize="48sp"
                android:textStyle="bold" />

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/walkProgressBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:max="300"
                android:progress="300"
                app:indicatorColor="@color/blue_accent"
                app:trackColor="@color/blue_light"
                app:trackCornerRadius="4dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Action Buttons -->
    <LinearLayout
        android:id="@+id/layoutWalkInitialButtons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:orientation="vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStartWalking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="🚶 I'm Walking! (Start 5 min)"
            android:textAllCaps="false"
            android:textColor="@color/blue_accent"
            android:textSize="16sp"
            app:backgroundTint="@color/white"
            app:cornerRadius="16dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSnoozeWalk"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="😴 Snooze (Remind in 2 min)"
            android:textAllCaps="false"
            android:textColor="@color/white"
            app:cornerRadius="14dp"
            app:strokeColor="#80FFFFFF" />
    </LinearLayout>

    <!-- Finish Early Button (When timer is running) -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFinishWalkEarly"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="✅ Finished Walk (Next 20m Cycle)"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="16sp"
        android:visibility="gone"
        app:backgroundTint="@color/green_accent"
        app:cornerRadius="16dp" />

</LinearLayout>
